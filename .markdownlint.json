{
  "default": true,

  // Allow common GitHub inline HTML
  "MD033": {
    "allowed_elements": [
      "details",
      "summary",
      "img",
      "br",
      "hr",
      "a",
      "table",
      "thead",
      "tbody",
      "tr",
      "td",
      "th"
    ]
  },

  // GitHub READMEs often exceed 80 chars, especially links
  "MD013": {
    "line_length": 120,
    "code_blocks": false,
    "tables": false,
    "headings": false,
    "ignore_urls": true
  },

  // Allow fenced code blocks without language tags
  "MD040": false,

  // Allow multiple top-level headings (common in READMEs)
  "MD025": {
    "level": 1,
    "front_matter_title": ""
  },

  // Allow HTML-style headings if needed
  "MD041": false,

  // GitHub often uses long lists, nested lists, etc.
  "MD007": {
    "indent": 2
  },

  // Allow inline emphasis inside headings
  "MD039": false
}
